@echo off
title Glance 2.4.1 Setup
setlocal
set "SM_SELF=%~f0"
set "SM_ARGS=%*"
powershell -NoProfile -NoLogo -ExecutionPolicy Bypass -STA -Command "$t=[IO.File]::ReadAllText($env:SM_SELF);$b=$t.Substring($t.IndexOf(':'+':PAYLOAD'));$h=@{};$n=$null;$sb=$null;foreach($l in $b.Split([char]10)){$l=$l.Trim();if($l.StartsWith(':'+':FILE ')){if($n){$h[$n]=$sb.ToString()};$n=$l.Substring(7).Trim();$sb=New-Object Text.StringBuilder}elseif($l.StartsWith(':'+':END')){if($n){$h[$n]=$sb.ToString()};break}elseif($n){[void]$sb.Append($l)}};$c=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($h['Install.ps1']));$h.Remove('Install.ps1');& ([scriptblock]::Create($c)) -Files $h -SetupArgs $env:SM_ARGS;exit $LASTEXITCODE"
exit /b %errorlevel%

